rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Shared helpers for Seoul Bowl Orders + Seoul Bowl Ops.
    function isSignedIn() {
      return request.auth != null;
    }

    function signedIn() {
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    function isManager() {
      return isSignedIn() && request.auth.token.role == "manager";
    }

    function managerStoreId() {
      return request.auth.token.storeId;
    }

    function storeId() {
      return request.auth.token.storeId;
    }

    // ── Orders app helpers ────────────────────────────────────────────────
    function isManagerWritableStatus(status) {
      return status in ["draft", "submitted"];
    }

    function effectiveOrderTypeId(data) {
      return data.get("order_type_id", "order_sb");
    }

    function managerOrderTypeIdUnchanged() {
      return effectiveOrderTypeId(request.resource.data) == effectiveOrderTypeId(resource.data);
    }

    function isParsSubcollectionParent(id) {
      return id.matches("^order_[a-z0-9_]+$");
    }

    // ── Ops app helpers ───────────────────────────────────────────────────
    function issueVisible() {
      return isAdmin()
        || resource.data.created_by_uid == request.auth.uid
        || request.auth.uid in resource.data.assignee_uids
        || request.auth.uid in resource.data.watcher_uids
        || (resource.data.location_id != null && resource.data.location_id == storeId());
    }

    function issueWritable() {
      return isAdmin()
        || resource.data.created_by_uid == request.auth.uid
        || request.auth.uid in resource.data.assignee_uids
        || (resource.data.location_id != null && resource.data.location_id == storeId());
    }

    function issueDocVisible(issueId) {
      let issue = get(/databases/$(database)/documents/issues/$(issueId));
      return isAdmin()
        || issue.data.created_by_uid == request.auth.uid
        || request.auth.uid in issue.data.assignee_uids
        || request.auth.uid in issue.data.watcher_uids
        || (issue.data.location_id != null && issue.data.location_id == storeId());
    }

    // ── Orders app rules: preserved from seoul-bowl-orders ────────────────
    match /tiers/{tierId} {
      allow read: if isManager() || isAdmin();
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isManager() || isAdmin();
      allow write: if isAdmin();
    }

    match /items/{itemId} {
      allow read: if isManager() || isAdmin();
      allow write: if isAdmin();
    }

    match /tierPrices/{tierPriceId} {
      allow read: if isManager() || isAdmin();
      allow write: if isAdmin();
    }

    match /order_types/{orderTypeId} {
      allow read: if isManager() || isAdmin();
      allow write: if isAdmin();
    }

    match /tierPriceEditLog/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.size() <= 14 &&
        request.resource.data.tier_id is string &&
        request.resource.data.tier_id.size() < 128 &&
        request.resource.data.order_type_id is string &&
        request.resource.data.order_type_id.size() > 0 &&
        request.resource.data.order_type_id.size() < 128 &&
        request.resource.data.item_id is string &&
        request.resource.data.item_id.size() < 128 &&
        request.resource.data.tier_price_doc_id is string &&
        request.resource.data.tier_price_doc_id.size() < 256 &&
        request.resource.data.changed_at is timestamp &&
        (request.resource.data.editor_uid is string || request.resource.data.editor_uid == null) &&
        (request.resource.data.editor_uid == null || request.resource.data.editor_uid.size() < 128) &&
        (request.resource.data.price_override_before is number || request.resource.data.price_override_before == null) &&
        (request.resource.data.price_override_after is number || request.resource.data.price_override_after == null) &&
        (request.resource.data.hidden_before is bool || request.resource.data.hidden_before == null) &&
        request.resource.data.hidden_after is bool;
      allow update, delete: if false;
    }

    match /stores/{storeId} {
      allow read: if isAdmin() || (isManager() && storeId == managerStoreId());
      allow write: if isAdmin();

      match /order_type_config/{orderTypeId} {
        allow read: if isAdmin() || (isManager() && storeId == managerStoreId());
        allow write: if isAdmin();
      }

      match /catalogs/{orderTypeId}/entries/{itemId} {
        allow read: if isAdmin() || (isManager() && storeId == managerStoreId());
        allow write: if isAdmin();
      }

      match /catalog/{itemId} {
        allow read: if isAdmin() || (isManager() && storeId == managerStoreId());
        allow write: if isAdmin();
      }

      match /pars/{orderTypeId}/entries/{itemId} {
        allow read: if isAdmin() || (isManager() && storeId == managerStoreId());
        allow write: if isAdmin() || (
          isManager() &&
          storeId == managerStoreId() &&
          request.resource.data.par_qty is int &&
          request.resource.data.size() <= 10
        );
      }

      match /pars/{itemId} {
        allow read: if !isParsSubcollectionParent(itemId) && (
          isAdmin() || (isManager() && storeId == managerStoreId())
        );
        allow write: if !isParsSubcollectionParent(itemId) && (
          isAdmin() || (
            isManager() &&
            storeId == managerStoreId() &&
            request.resource.data.par_qty is int &&
            request.resource.data.size() <= 10
          )
        );
      }

      match /item_overrides/{orderTypeId}/entries/{itemId} {
        allow read: if isAdmin();
        allow create, update: if isAdmin() &&
          request.resource.data.visibility in ["inherit", "force_show", "force_hide"] &&
          request.resource.data.size() <= 5;
        allow delete: if isAdmin();
      }

      match /item_overrides/{itemId} {
        allow read: if isAdmin();
        allow create, update: if isAdmin() &&
          request.resource.data.visibility in ["inherit", "force_show", "force_hide"] &&
          request.resource.data.size() <= 5;
        allow delete: if isAdmin();
      }
    }

    match /{path=**}/order_type_config/{orderTypeId} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isManager() && resource.data.store_id == managerStoreId());
      allow create: if isAdmin() || (
        isManager() &&
        request.resource.data.store_id == managerStoreId() &&
        request.resource.data.order_type_id is string &&
        request.resource.data.order_type_id.size() > 0 &&
        request.resource.data.order_type_id.size() < 128 &&
        isManagerWritableStatus(request.resource.data.status)
      );
      allow update: if isAdmin() || (
        isManager() &&
        resource.data.store_id == managerStoreId() &&
        isManagerWritableStatus(resource.data.status) &&
        request.resource.data.store_id == resource.data.store_id &&
        managerOrderTypeIdUnchanged() &&
        isManagerWritableStatus(request.resource.data.status)
      );
      allow delete: if isAdmin() || (
        isManager() &&
        resource.data.store_id == managerStoreId() &&
        resource.data.status == "draft"
      );

      match /order_lines/{lineId} {
        allow read: if isAdmin() || (
          isManager() && (
            resource.data.store_id == managerStoreId() ||
            (
              exists(/databases/$(database)/documents/orders/$(orderId)) &&
              get(/databases/$(database)/documents/orders/$(orderId)).data.store_id == managerStoreId()
            )
          )
        );
        allow create: if isAdmin() || (
          isManager() &&
          request.resource.data.store_id == managerStoreId() &&
          request.resource.data.qty is int &&
          request.resource.data.size() <= 20
        );
        allow update: if isAdmin() || (
          isManager() &&
          resource.data.store_id == managerStoreId() &&
          request.resource.data.store_id == resource.data.store_id &&
          request.resource.data.qty is int
        );
        allow delete: if isAdmin() || (isManager() && resource.data.store_id == managerStoreId());
      }
    }

    // ── Ops app rules ─────────────────────────────────────────────────────
    match /counters/{counterId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /userProfiles/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /labels/{labelId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();

      match /activity/{activityId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if false;
      }
    }

    match /issues/{issueId} {
      allow read: if signedIn() && issueVisible();
      allow create: if signedIn();
      allow update: if signedIn() && issueWritable();
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if signedIn() && issueDocVisible(issueId);
        allow create: if signedIn() && issueDocVisible(issueId);
        allow update, delete: if isAdmin() || resource.data.author_uid == request.auth.uid;
      }

      match /activity/{activityId} {
        allow read: if signedIn() && issueDocVisible(issueId);
        allow create: if false;
        allow update, delete: if false;
      }

      match /checklist/{itemId} {
        allow read: if signedIn() && issueDocVisible(issueId);
        allow create, update: if false;
        allow delete: if false;
      }
    }

    match /notificationEvents/{eventId} {
      allow read, write: if isAdmin();
    }

    match /notificationInbox/{inboxId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /notificationPreferences/{uid} {
      allow read, write: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /recurringTemplates/{templateId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /pilotFeedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /employees/{employeeId} {
      allow read, write: if isAdmin();

      match /folders/{folderId} {
        allow read, write: if isAdmin();
      }

      match /documents/{documentId} {
        allow read, write: if isAdmin();
      }

      match /feedback/{feedbackId} {
        allow read, write: if isAdmin();
      }

      match /compEntries/{entryId} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
