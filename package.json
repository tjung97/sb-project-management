{
  "name": "sb-project-management",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke-routes.mjs",
    "test:all": "npm run lint && npm run test && npm run build && npm --prefix functions run build && npm run verify:ops && npm run test:smoke",
    "seed": "npx tsx scripts/seed.ts",
    "migrate:ops": "npx tsx scripts/migrate-ops-data.ts",
    "verify:ops": "npx tsx scripts/verify-ops-config.ts",
    "deploy:indexes": "npx firebase-tools deploy --only firestore:indexes",
    "deploy:rules:merged": "npx firebase-tools deploy --only firestore:rules --config firebase.merged.json",
    "emulators": "npx firebase-tools emulators:start --only auth,firestore,functions"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.13.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.16.0",
    "luxon": "^3.7.2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "firebase-tools": "^15.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
